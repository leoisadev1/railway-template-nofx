# HTTP Basic password (username "setup") for owner registration. 16+ letters, digits, _ or -. Railway generates it.
SETUP_PASSWORD=change-me-setup-password
# 32+ character session seed; every restart derives a new signing key from it. Railway generates it.
JWT_SECRET=change-me-to-a-32-character-seed-value
# Encrypts stored exchange and model credentials. Keep it stable with the volume. Railway generates it.
DATA_ENCRYPTION_KEY=change-me-data-encryption-key
# nginx port; the backend listens on 127.0.0.1:8081 inside the container.
PORT=8080
# Optional: browser-side credential encryption on top of HTTPS.
# TRANSPORT_ENCRYPTION=false
# Optional: upstream usage telemetry to Google Analytics. The wrapper sets false unless you opt in.
# EXPERIENCE_IMPROVEMENT=false
# Optional: CIDRs of the reverse proxy whose X-Real-IP nginx takes as the client address for the login
# rate limit. Default is Railway's edge range. That proxy must set X-Real-IP to the client and drop the
# client's own value. Never add ranges other clients or services connect from.
# EDGE_PROXY_CIDRS=100.64.0.0/10
# Optional: the header that proxy carries the client in, exactly X-Real-IP (default, Railway) or
# X-Forwarded-For (rightmost entry not in EDGE_PROXY_CIDRS, as in 1.1.0) for a proxy that sends no X-Real-IP.
# EDGE_CLIENT_IP_HEADER=X-Real-IP
